# MongoDB Ports
MONGODB_DEV_PORT=27019
MONGODB_PROD_PORT=27020

# Connection Strings & DB Name
# Dev (docker network): mongodb://mongodb_dev:27017/speakup
# Dev (local host): mongodb://localhost:27019/speakup
MONGO_CONNECTION_STRING=mongodb://mongodb_dev:27017/speakup
DB_NAME=speakup

# Auth
JWT_KEY=change-me-to-a-long-random-secret

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FREE_DAILY_AI_LIMIT=10

# SambaNova AI
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Ollama AI
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest

# SMTP
APP_NAME=SpeakUp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=http://localhost:5175/checkout/success
STRIPE_CANCEL_URL=http://localhost:5175/checkout/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:5175/perfil
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Frontend
VITE_API_URL=http://localhost:8082/api
VITE_STRIPE_PRICE_MONTHLY=
VITE_STRIPE_PRICE_ANNUAL=

# Firebase (Frontend)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=
