# MongoDB Ports
MONGODB_DEV_PORT=27019
MONGODB_PROD_PORT=27020

# Connection Strings & DB Name
# Dev (docker network): mongodb://mongodb_dev:27017/speakup
# Dev (local host): mongodb://localhost:27019/speakup
MONGO_CONNECTION_STRING=mongodb://mongodb_dev:27017/speakup
DB_NAME=speakup

# Auth
JWT_KEY=change-me-to-a-long-random-secret

# AI Provider Selection ("ollama" or "gemini")
AI_PROVIDER=ollama

# Ollama AI Configuration
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest

# Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend (API URL)
# Local Dev: http://localhost:8082/api
# Production: https://api.speak-up.xyz/api
VITE_API_URL=http://localhost:8082/api